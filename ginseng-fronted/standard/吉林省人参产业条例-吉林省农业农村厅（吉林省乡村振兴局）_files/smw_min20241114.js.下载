                                     }else{
                                     $(".link_qt").append("<p style='height: 30px;line-height:30px;'><a href='" + res_link["qt"][i].url + "' target='_blank'>" + res_link["qt"][i].name + "</a></p>")
                                     }
                                  }
                              }
                          }
                                $(".link_W_Sub a").each(function () {
                                var link = $(this).attr("href");
                                if (link.indexOf("javascript") >= 0) {
                                    $(this).attr("target", "_self");
                                }
                            })
                      },
                      error: function (e) {  //请求超时回调
                          if (e.statusText == "timeout") {
                              console.log("相关链接请求超时")
                          }
                      },
                  })

              }


