                                          }
                                      }
                                  }
                              }
                              //输出其他链接
                              else {
                                  for (var i = 0; i < res_link["qt"].length; i++) {
                                      if(i < res_link["qt"].length -2){
                                          $(".link_qt").append("<a href='" + res_link["qt"][i].url + "' target='_blank'>" + res_link["qt"][i].name + "</a>")
