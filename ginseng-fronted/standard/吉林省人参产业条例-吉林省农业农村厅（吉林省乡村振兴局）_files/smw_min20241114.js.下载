function qglb() {
  $.ajax({
    url: "https://www.agri.cn/qgxxlb/qgxxlb.jsonp",
    dataType: "jsonp",
    scriptCharset: "UTF-8",
    jsonp: 'pushInfoJsonpCallBack',
