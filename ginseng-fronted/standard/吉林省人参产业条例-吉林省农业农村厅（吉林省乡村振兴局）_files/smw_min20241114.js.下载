    success: function success(qglb) {
      //console.log(qglb);
      var htm = "";
      
      for (var i = 0; i < 10; i++) {
        time3 = qglb[i].pubDate;
      if(www<=768){time3 = time3.substr(5, 10);
        
      }else{
        time3 = time3;

      }
        htm += '<li><a target="_blank" title="' + qglb[i].title + '" href="' + qglb[i].link + '"><p>[' + qglb[i].source + ']</p> ' + qglb[i].title + '</a><span class="date">' + time3 + '</span></li>';
