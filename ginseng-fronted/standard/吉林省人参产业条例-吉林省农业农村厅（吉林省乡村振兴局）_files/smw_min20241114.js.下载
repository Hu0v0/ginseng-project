function hg(e) {
  $('.currency_ul').each(function () {
    var uid = $(this).attr("data-uid");

    var www = window.screen.width;
    var divlist = $(this).find('li')
    var h = 0;
    for (var i = 0; i < divlist.length; i++) {
      h += divlist.eq(i).outerHeight(true);

      if (h > uid && www > 760) {

        divlist.eq(i).remove();
      } else if (h > uid * 1 + 100 && www < 760) {
        divlist.eq(i).remove();
      }
      else if (h > uid * 1 + 100 && www < 480) {
        divlist.eq(i).remove();
      }
    }
  }
  )
}
